  "sources": [
    {
      "id": "nasa-1-6bc65e96f702",
      "doc_id": "nasa-1",
      "title": "Risks of Human Spaceflight - NASA",
      "url": "https://www.nasa.gov/hrp/risks/",
      "publisher": "NASA / Human Research Program",
      "text": "All astronauts perform exercise during their mission to counteract losses in bone density, muscle strength, and heart and blood vessel performance. Researchers are studying what types of exercise will best protect their health and their ability to perform spacewalks.",
      "retrieved": "2026-11-13",
      "source_date": null,
      "version": "eb196f0d1839a237063b149c8f3ad16534bd75a6b4d2aa41e76183abcf5b2a49",
      "retrieval_status": "active"
    },
    {
      "id": "nasa-3-ea918f070609",
      "doc_id": "nasa-3",
      "title": "The Human Body in Space - NASA",
      "url": "https://www.nasa.gov/humans-in-space/the-human-body-in-space/",
      "publisher": "NASA / Human Research Program",
      "text": "NASA scientists are using devices, such as actigraphy, that help assess and improve sleep and alertness by recording how much people move and how much ambient light is around them. New lighting, spurred by the development of Light-Emitting Diode (LED) technology, is used on the space station to help align astronaut’s circadian rhythms and to improve sleep, alertness, and performance.",
      "retrieved": "2026-11-13",
      "source_date": null,
      "version": "f80287bb7163716c022f53452397a9850ca559985ff1744859824bb6cca26b2f",
      "retrieval_status": "active"
    },
    {
      "id": "nasa-1-936223e0c984",
      "doc_id": "nasa-1",
      "title": "Risks of Human Spaceflight - NASA",
      "url": "https://www.nasa.gov/hrp/risks/",
      "publisher": "NASA / Human Research Program",
      "text": "Space crews experience multiple hazards simultaneously. Stressors include chronic sleep loss, constant work demands, and irregularities in their internal biological clocks. Understanding how to reduce the effects of these stressors on crew health and safety is an ongoing area of research.",
      "retrieved": "2026-11-13",
      "source_date": null,
      "version": "eb196f0d1839a237063b149c8f3ad16534bd75a6b4d2aa41e76183abcf5b2a49",
      "retrieval_status": "active"
    },
    {
      "id": "nasa-2-6e5e15f05a88",
      "doc_id": "nasa-2",
      "title": "Hazard: Isolation and Confinement - NASA",
      "url": "https://www.nasa.gov/hrp/hazard-isolation-and-confinement/",
      "publisher": "NASA / Human Research Program",
      "text": "On Earth, we have the luxury of picking up our cell phones and instantly being connected with nearly everything and everyone around us. On a trip to Mars, astronauts will be more isolated and confined than we can imagine. Sleep loss, circadian desynchronization, and work overload compound this issue and may lead to decreased performance, adverse health outcomes, and compromised mission objectives.",
      "retrieved": "2026-11-13",
      "source_date": null,
      "version": "7647502926c043aa2a83a5c132182d95c1840035bbd96e63fc33bd22f93aed04",
      "retrieval_status": "active"
    },
    {
      "id": "nasa-2-52190af7daa9",
      "doc_id": "nasa-2",
      "title": "Hazard: Isolation and Confinement - NASA",
      "url": "https://www.nasa.gov/hrp/hazard-isolation-and-confinement/",
      "publisher": "NASA / Human Research Program",
      "text": "To address this hazard, experts are developing methods for monitoring behavioral health and adapting/refining various tools and technologies for use in the spaceflight environment to detect and treat early risk factors. Research is also being conducted in workload and performance, light therapy for circadian alignment, phase shifting and alertness. Learn more about how NASA studies isolation and confinement:",
      "retrieved": "2026-11-13",
      "source_date": null,
      "version": "7647502926c043aa2a83a5c132182d95c1840035bbd96e63fc33bd22f93aed04",
      "retrieval_status": "active"
    },
    {
      "id": "nasa-1-8f3266c7337d",
      "doc_id": "nasa-1",
      "title": "Risks of Human Spaceflight - NASA",
      "url": "https://www.nasa.gov/hrp/risks/",
      "publisher": "NASA / Human Research Program",
      "text": "Weightlessness alters blood circulation and how the heart and blood vessels function, potentially increasing the risk of cardiovascular events. Research focuses on minimizing these unhealthy changes.",
      "retrieved": "2026-11-13",
      "source_date": null,
      "version": "eb196f0d1839a237063b149c8f3ad16534bd75a6b4d2aa41e76183abcf5b2a49",
      "retrieval_status": "active"
    },
    {
      "id": "nasa-1-0412b8b164f7",
      "doc_id": "nasa-1",
      "title": "Risks of Human Spaceflight - NASA",
      "url": "https://www.nasa.gov/hrp/risks/",
      "publisher": "NASA / Human Research Program",
      "text": "Isolation, radiation, distance from Earth, and other intense space stressors may all take a toll on the mental health of the crew. Ongoing research seeks to better understand and quantify these psychological risks.",
      "retrieved": "2026-11-13",
      "source_date": null,
      "version": "eb196f0d1839a237063b149c8f3ad16534bd75a6b4d2aa41e76183abcf5b2a49",
      "retrieval_status": "active"
    },
    {
      "id": "nasa-2-27888d4219a8",
      "doc_id": "nasa-2",
      "title": "Hazard: Isolation and Confinement - NASA",
      "url": "https://www.nasa.gov/hrp/hazard-isolation-and-confinement/",
      "publisher": "NASA / Human Research Program",
      "text": "Take a peek into the lives of crew on a simulated mission to Mars. Confined inside NASA's Human Exploration Research Analog (HERA), these crew help researchers study how teams overcome isolation and confinement to accomplish mission-critical tasks.",
      "retrieved": "2026-11-13",
      "source_date": null,
      "version": "7647502926c043aa2a83a5c132182d95c1840035bbd96e63fc33bd22f93aed04",
      "retrieval_status": "active"
    },
    {
      "id": "nasa-1-2b0e5ab85409",
      "doc_id": "nasa-1",
      "title": "Risks of Human Spaceflight - NASA",
      "url": "https://www.nasa.gov/hrp/risks/",
      "publisher": "NASA / Human Research Program",
      "text": "Selecting a crew that works well together is essential for mission success and safety. Researchers are studying how to help teams in prolonged isolation and confinement function efficiently and quickly recover after setbacks occur. They’re also mapping the myriad risks from miscommunications and related team tensions.",
      "retrieved": "2026-11-13",
      "source_date": null,
      "version": "eb196f0d1839a237063b149c8f3ad16534bd75a6b4d2aa41e76183abcf5b2a49",
      "retrieval_status": "active"
    }
  ]
}
